model Doctor {
    id                  String            @id @default(uuid(7))
    name                String            @db.VarChar(255)
    email               String            @unique @db.VarChar(255)
    profilePhoto        String?
    contactNumber       String?           @db.VarChar(20)
    address             String?           @db.Text
    registrationNumber  String            @unique @db.VarChar(100)
    experience          Int               @default(0)
    gender              Gender
    appointmentFee      Float
    qualification       String            @db.Text
    currentWorkingPlace String            @db.Text
    designation         String            @db.VarChar(255)
    averageRating       Float             @default(0.0)
    isDeleted           Boolean           @default(false)
    deletedAt           DateTime?
    createdAt           DateTime          @default(now())
    updatedAt           DateTime          @updatedAt
    specialties         DoctorSpecialty[]

    // relations
    userId String @unique
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([email], name: "idx_doctor_email")
    @@index([isDeleted], name: "idx_doctor_isDeleted")
    @@map("doctor")
}
